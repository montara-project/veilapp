{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "veilapp",
  "version": "0.0.0",
  "identifier": "com.montara.veilapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Hide menu bar and monitoring memory usage"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5QzEwNUZBN0FFOTMyMkQKUldRdE11bDYrZ1hCS1dvWW1QSEkrZlRZTlpBZzFSd1ZVMzY1NGhaVEJvek9uWWl6Unh0S0RZS2IK",
      "endpoints": [
        "https://github.com/montara-project/veilapp/releases/latest/download/latest.json"
      ]
    }
  }
}
